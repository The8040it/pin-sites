{
 "name": "Bing Maps",
 "short_name": "Bing Maps",
 "description": "Bing Maps on Android – search and directions",
 "id": "/",
 "start_url": "/?app=1",
 "scope": "/",
 "display": "standalone",
 "orientation": "portrait",
 "background_color": "#6a3bd2",
 "theme_color": "#6a3bd2",
 "dir": "rtl",
 "lang": "yi",
 "icons": [
  {
   "src": "/icon-192.png",
   "sizes": "192x192",
   "type": "image/png",
   "purpose": "any"
  },
  {
   "src": "/icon-512.png",
   "sizes": "512x512",
   "type": "image/png",
   "purpose": "any"
  },
  {
   "src": "/icon-maskable-192.png",
   "sizes": "192x192",
   "type": "image/png",
   "purpose": "maskable"
  },
  {
   "src": "/icon-maskable-512.png",
   "sizes": "512x512",
   "type": "image/png",
   "purpose": "maskable"
  }
 ],
 "shortcuts": [
  {
   "name": "זוך · Search",
   "url": "/?home=1&go=search",
   "icons": [
    {
     "src": "/icon-192.png",
     "sizes": "192x192"
    }
   ]
  },
  {
   "name": "וועגווייזער · Directions",
   "url": "/?home=1&go=directions",
   "icons": [
    {
     "src": "/icon-192.png",
     "sizes": "192x192"
    }
   ]
  }
 ],
 "share_target": {
  "action": "/",
  "method": "GET",
  "params": {
   "title": "title",
   "text": "text",
   "url": "url"
  },
  "enctype": "application/x-www-form-urlencoded"
 }
}