/* ---------- audio ---------- */
const player = { el: $('#player'), cur: '', item: null };
function playItem(it) {
  const el = player.el;
  if (player.cur === it.audio) { el.paused ? el.play() : el.pause(); return; }
  player.cur = it.audio; player.item = it; el.src = it.audio; el.play().catch(() => toast('קען נישט שפילן'));
  $('#miniTitle').textContent = it.title; $('#mini').hidden = false;
  if ('mediaSession' in navigator) { try { navigator.mediaSession.metadata = new MediaMetadata({ title: it.title, artist: (SRC[it.src] || {}).name || 'סאטמאר נייעס' }); } catch (_) {} }
}
function syncPlay() { const p = !player.el.paused; $('#miniPlay').textContent = p ? '❚❚' : '▶'; document.querySelectorAll('[data-play]').forEach(b => { const it = itemsIndex.get(b.dataset.play); b.textContent = it && it.audio === player.cur && p ? '❚❚' : '▶'; }); }
['play', 'pause', 'ended'].forEach(e => player.el.addEventListener(e, syncPlay));
player.el.addEventListener('timeupdate', () => { const el = player.el; if (el.duration) $('#miniProg').style.width = (100 * el.currentTime / el.duration) + '%'; });
$('#miniPlay').onclick = () => { player.el.paused ? player.el.play() : player.el.pause(); };
$('#miniClose').onclick = () => { player.el.pause(); player.el.removeAttribute('src'); player.cur = ''; $('#mini').hidden = true; syncPlay(); };
