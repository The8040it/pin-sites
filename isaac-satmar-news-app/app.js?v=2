const COLORS = ['#C9A240', '#2E5AAC', '#8E1B2B', '#1F7A5A', '#7A4BB0', '#C2621A', '#16808C', '#A23B72', '#5C6B1F', '#3F51B5', '#9C7A26', '#B03A2E', '#2C7DA0', '#6D4C41', '#00897B', '#7B1FA2', '#455A64', '#AD1457', '#558B2F', '#283593'];
const LS = {
