/* ---------- reader ---------- */
const reader = $('#reader'), art = $('#art');
function canFetch(it) { return !it.full && /^https:\/\/((www\.)?yiddish24\.com|jdn\.news|(www\.)?bechatzros\.com|(www\.)?ahblicklive\.com\/post\.php)/.test(it.url || ''); }
function openReader(it, push = true) {
  state.reader = it; reader.hidden = false; document.body.style.overflow = 'hidden';
  if (push) history.pushState({ reader: it.url }, '', '?a=' + encodeURIComponent(it.url));
  $('#rscroll').scrollTop = 0;
  if (!canFetch(it)) { paintReader(it, false); return; }
  paintReader(it, true);
  api('/api/item?u=' + encodeURIComponent(it.url)).then(d => {
    if (state.reader !== it) return;
    const x = d.item || {};
    const full = { ...it, paras: (x.paras || []).join('').length > (it.paras || []).join('').length ? x.paras : it.paras, image: it.image || x.image, video: it.video || x.video, audio: it.audio || x.audio, title: it.title && it.title !== '…' ? it.title : x.title, gallery: x.gallery || 0, duration: it.duration || x.duration };
