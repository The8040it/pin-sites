function waLink(it) { return 'https://wa.me/?text=' + encodeURIComponent(it.title + '\n\n' + it.url + '\n\n— פון ' + ((SRC[it.src] || {}).name || it.srcName || '') + ', דורך סאטמאר נייעס'); }
function closeReader(fromPop) {
