/* ---------- events ---------- */
document.addEventListener('click', e => {
  const t = e.target.closest('[data-play],[data-open],[data-src],[data-tab],[data-feedmore],[data-srctoggle],[data-showa],[data-retry],[data-save],[data-theme-set],[data-fs-set],[data-install],[data-nav]');
  if (!t) return;
  const ds = t.dataset;
  if (ds.play) { e.stopPropagation(); const it = itemsIndex.get(ds.play); if (it) playItem(it); return; }
  if (ds.open) { const it = itemsIndex.get(ds.open); if (it) openReader(it); return; }
  if (ds.tab) { state.tab = ds.tab; state.shown = 30; scrollTo(0, 0); show(); t.scrollIntoView({ inline: 'center', block: 'nearest' }); return; }
  if (ds.src) {
    const k = ds.src;
    if (k !== 'all' && !srcOn().includes(k)) { setSrc(k, true); toast((SRC[k] || {}).name + ' — אנגעצונדן ✔'); }
    state.src = k; state.shown = 30; scrollTo(0, 0); show(); return;
  }
  if (ds.nav) { if (state.nav === ds.nav) { scrollTo({ top: 0, behavior: 'smooth' }); return; } state.nav = ds.nav; scrollTo(0, 0); show(); return; }
  if (t.hasAttribute('data-feedmore')) { state.shown += 30; show(); return; }
  if (ds.srctoggle) { const k = ds.srctoggle; const on = !srcOn().includes(k); setSrc(k, on); if (!on && state.src === k) state.src = 'all'; t.classList.toggle('on', on); state.feed = state.feed; return; }
  if (t.hasAttribute('data-showa')) { const v = !showA(); LS.set('sn.showA', v); t.classList.toggle('on', v); return; }
  if (t.hasAttribute('data-retry')) { show(true); return; }
  if (t.hasAttribute('data-save')) { const on = toggleSave(state.reader); t.classList.toggle('on', on); t.textContent = on ? '🔖 געהאלטן' : '🔖 היטן'; $('#rSave').classList.toggle('on', on); return; }
  if (ds.themeSet) { setTheme(ds.themeSet); show(); return; }
  if (ds.fsSet) { setFs(+ds.fsSet); show(); return; }
  if (t.hasAttribute('data-install')) { doInstall(); }
});
$('#rBack').onclick = () => closeReader();
$('#rSave').onclick = () => { if (!state.reader) return; const on = toggleSave(state.reader); $('#rSave').classList.toggle('on', on); const sb = art.querySelector('[data-save]'); if (sb) { sb.classList.toggle('on', on); sb.textContent = on ? '🔖 געהאלטן' : '🔖 היטן'; } };
$('#rShare').onclick = async () => {
  const it = state.reader; if (!it) return;
  if (navigator.share) { try { await navigator.share({ title: it.title, text: it.title, url: it.url }); } catch (_) {} return; }
  location.href = waLink(it);
};
$('#btnRefresh').onclick = () => window.__refresh();

/* theme + font size */
function setTheme(t) { LS.set('sn.theme', t); applyTheme(); }
function applyTheme() {
  const t = LS.get('sn.theme', 'auto');
  const dark = t === 'dark' || (t === 'auto' && matchMedia('(prefers-color-scheme: dark)').matches);
  document.documentElement.dataset.theme = dark ? 'dark' : 'light';
  $('#btnTheme').textContent = dark ? '☀' : '☾';
}
matchMedia('(prefers-color-scheme: dark)').addEventListener('change', applyTheme);
$('#btnTheme').onclick = () => { setTheme(document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark'); if (state.nav === 'more') show(); };
function setFs(v) { LS.set('sn.fsv', v); localStorage.setItem('sn.fs', String(v)); document.documentElement.style.setProperty('--fs', v); }
function cycleFs() { const cur = LS.get('sn.fsv', 1); const i = FS_STEPS.indexOf(cur); const n = FS_STEPS[(i + 1) % FS_STEPS.length]; setFs(n); toast('שריפט: ' + Math.round(n * 100) + '%'); }
$('#btnSize').onclick = cycleFs; $('#rSize').onclick = cycleFs;
applyTheme();

/* pull to refresh */
(function () {
  const ptr = $('#ptr'); let y0 = null, dy = 0, busy = false;
  window.addEventListener('touchstart', e => { if (!reader.hidden || busy) return; if (window.scrollY <= 0) { y0 = e.touches[0].clientY; dy = 0; } else y0 = null; }, { passive: true });
  window.addEventListener('touchmove', e => {
    if (y0 == null) return; dy = e.touches[0].clientY - y0;
    if (dy > 0 && window.scrollY <= 0) { ptr.style.transition = 'none'; ptr.style.height = Math.min(70, dy * 0.45) + 'px'; $('#ptrText').textContent = dy > 140 ? 'לאזט אפ צו דערפרישן' : 'ציט אראפ צו דערפרישן'; }
  }, { passive: true });
  window.addEventListener('touchend', async () => { if (y0 == null) return; y0 = null; ptr.style.transition = ''; if (dy > 140) await refresh(); else ptr.style.height = '0'; });
  async function refresh() {
    if (busy) return; busy = true; ptr.style.height = '54px'; ptr.classList.add('spin'); $('#ptrText').textContent = 'דערפרישט…';
    try { state.nav = 'news'; await show(true); toast('דערפרישט ✔'); } finally { ptr.classList.remove('spin'); ptr.style.height = '0'; busy = false; }
  }
  window.__refresh = refresh;
})();

/* install */
let deferredInstall = null;
window.addEventListener('beforeinstallprompt', e => { e.preventDefault(); deferredInstall = e; $('#btnInstall').hidden = false; });
async function doInstall() { if (!deferredInstall) return; deferredInstall.prompt(); try { await deferredInstall.userChoice; } catch (_) {} deferredInstall = null; $('#btnInstall').hidden = true; }
$('#btnInstall').onclick = doInstall;
window.addEventListener('appinstalled', () => { $('#btnInstall').hidden = true; toast('אינסטאלירט ✔'); });
if ('serviceWorker' in navigator) navigator.serviceWorker.register('/sw.js').catch(() => {});

let hiddenAt = 0;
document.addEventListener('visibilitychange', () => { if (document.hidden) hiddenAt = Date.now(); else if (hiddenAt && Date.now() - hiddenAt > 240000 && reader.hidden && state.nav === 'news') show(true); });

/* start */
(async () => {
  const qs = new URLSearchParams(location.search);
  if (qs.get('tab') && TABS.some(t => t[0] === qs.get('tab'))) state.tab = qs.get('tab');
  if (qs.get('nav') && ['news', 'saved', 'more'].includes(qs.get('nav'))) state.nav = qs.get('nav');
  main.innerHTML = skeleton();
  try { await loadSources(); } catch (_) { main.innerHTML = `<div class="empty">קען נישט לאדן יעצט.<br><button class="more-btn" style="margin-top:14px" onclick="location.reload()">פרובירן נאכאמאל</button></div>`; return; }
  show();
  const deep = qs.get('a');
  if (deep && /^https:\/\//.test(deep)) { history.replaceState({}, '', '/'); openReader({ url: deep, title: '…', paras: [] }); }
})();
window.__sn = { state, openReader, closeReader, show };
})();
