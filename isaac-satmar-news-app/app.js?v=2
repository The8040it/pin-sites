/* ---------- sources ---------- */
async function loadSources() {
  const cached = LS.get('sn.srcList', null);
  if (cached) applySources(cached);
  try { const d = await api('/api/sources'); applySources(d.sources); LS.set('sn.srcList', d.sources); } catch (_) { if (!cached) throw new Error('no sources'); }
}
function applySources(list) {
