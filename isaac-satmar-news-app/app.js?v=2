      <a href="${esc(it.url)}" target="_blank" rel="noopener">${link}</a>
      ${it.also && it.also.length ? `<div class="meta" style="margin-top:8px">די זעלבע נייעס אויך ביי: ${it.also.map(x => `<a class="alsolink" href="${esc(x.url)}" target="_blank" rel="noopener">${esc((SRC[x.src] || {}).name || x.srcName)} ↗</a>`).join(' ')}</div>` : ''}</div>
