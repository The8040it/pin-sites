  const restBul = bul.filter(x => x !== heroIt);
  if (blitz.length) h += secHead('news/311', '⚡ בליצן') + blitzHTML(blitz.slice(0, 6));
  if (restBul.length) h += secHead('news/57', 'לעצטע נייעס') + restBul.slice(0, 6).map(it => cardHTML(it)).join('');
  if (alg.length) h += secHead('news/59', 'סך הכל פון די נייעס') + bigHTML(alg[0]) + alg.slice(1, 3).map(it => cardHTML(it)).join('');
