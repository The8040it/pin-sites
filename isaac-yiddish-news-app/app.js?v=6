  if (rest.length) h += `<div class="sec-h"><h3>${src === 'all' ? 'לעצטע נייעס פון אלע' : 'לעצטע נייעס'}</h3></div>`;
  shown.forEach((it, i) => { h += (i % 7 === 6 && it.image) ? bigHTML(it) : cardHTML(it, { badge: true }); });
  if (rest.length > shown.length) h += `<button class="more-btn" data-feedmore>ווייז מער ⌄</button>`;
  h += stamp(d.fetchedAt);
