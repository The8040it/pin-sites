/* ---------- events ---------- */
document.addEventListener('click', async e => {
  const t = e.target.closest('[data-play],[data-open],[data-src],[data-feedmore],[data-srctoggle],[data-chip],[data-goto],[data-more],[data-retry],[data-save],[data-theme-set],[data-fs-set],[data-install]');
  if (!t) return;
  if (t.dataset.play) { e.stopPropagation(); const it = itemsIndex.get(t.dataset.play); if (it) playItem(it); return; }
  if (t.dataset.open) { const it = itemsIndex.get(t.dataset.open); if (it) openReader(it); return; }
  if (t.dataset.src) {
    const k = t.dataset.src;
    if (k !== 'all' && !srcOn().includes(k)) { setSrc(k, true); toast(SRC[k].name + ' — אנגעצונדן ✔'); }
    state.newsSrc = k; state.feedShown = 40; scrollTo(0, 0); show(); return;
  }
  if (t.hasAttribute('data-feedmore')) { state.feedShown += 40; show(); return; }
  if (t.dataset.srctoggle) { const k = t.dataset.srctoggle; setSrc(k, !srcOn().includes(k)); if (state.newsSrc === k && !srcOn().includes(k)) state.newsSrc = 'all'; show(); return; }
  if (t.dataset.chip) { if (state.tab === 'news') state.newsSec = t.dataset.chip; else state.mediaSec = t.dataset.chip; scrollTo(0, 0); show(); return; }
  if (t.dataset.goto) { const [tab, key] = t.dataset.goto.split(':'); state.tab = tab; if (tab === 'news') { state.newsSrc = 'y24'; state.newsSec = key; } else state.mediaSec = key; scrollTo(0, 0); show(); return; }
  if (t.dataset.more !== undefined && t.dataset.more) return loadMore(t);
  if (t.hasAttribute('data-retry')) return show(true);
  if (t.hasAttribute('data-save')) { const on = toggleSave(state.reader); t.classList.toggle('on', on); t.textContent = on ? '🔖 געהאלטן' : '🔖 היטן'; $('#rSave').classList.toggle('on', on); return; }
  if (t.dataset.themeSet) { setTheme(t.dataset.themeSet); show(); return; }
