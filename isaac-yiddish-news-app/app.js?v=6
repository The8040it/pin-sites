}
function feedKey() { return state.newsSrc === 'all' ? 'feed:' + srcOn().join(',') : state.newsSrc === 'y24' ? state.newsSec : 'feed:' + state.newsSrc; }
function secHead(key, title, tab = 'news') { return `<div class="sec-h"><h3>${esc(title)}</h3><button data-goto="${tab}:${key}">אלע ‹</button></div>`; }

function renderSection(key, d) {
  const items = d.items || [];
  if (!items.length) return `<div class="empty">דערווייל קיין זאכן אין דעם טייל.</div>`;
  let h = `<h2 class="pg">${esc(NAMES[key] || d.name || '')}</h2>`;
  if (key === 'news/311') h += blitzHTML(items);
  else if (key === 'video' || key === 'torah') h += items.map(bigHTML).join('');
  else {
    const first = items.find(x => x.image && !x.audio) || null;
    if (first && /^news\/(57|59)$/.test(key)) h += bigHTML(first);
    h += items.filter(x => x !== first).map(it => cardHTML(it)).join('');
  }
  if (PAGINATE(key)) h += `<button class="more-btn" data-more="${esc(key)}">ווייז מער ⌄</button>`;
  h += stamp(d.fetchedAt);
  return h;
}

function cacheKey(k) { return 'yn.c.' + k; }
async function loadData(key, force) {
  if (!force && state.data[key] && Date.now() - state.data[key]._t < 180000) return state.data[key];
  const d = await api(key === 'home' ? '/api/home' : key.startsWith('feed:') ? '/api/feed?src=' + encodeURIComponent(key.slice(5)) : '/api/section?s=' + encodeURIComponent(key));
  d._t = Date.now(); state.data[key] = d; LS.set(cacheKey(key), d);
  return d;
}

let renderToken = 0;
async function show(force) {
  const tok = ++renderToken;
  const tab = state.tab;
  document.querySelectorAll('.bottom button').forEach(b => b.classList.toggle('on', b.dataset.tab === tab));
  if (tab === 'saved') { setChips(null); main.innerHTML = renderSaved(); return; }
  if (tab === 'more') { setChips(null); main.innerHTML = renderMore(); return; }
  const key = tab === 'news' ? feedKey() : state.mediaSec;
  if (tab === 'news') setChips(srcChipsHTML(), null, state.newsSrc === 'y24' ? NEWS_CHIPS : null, state.newsSec);
  else setChips(chipsHTML(MEDIA_CHIPS, key), null, null);
  const cachedD = state.data[key] || LS.get(cacheKey(key), null);
  const paint = d => { if (tok !== renderToken) return; main.innerHTML = key.startsWith('feed:') ? renderFeed(d, tab === 'media' ? 'all' : state.newsSrc) : key === 'home' ? renderHome(d) : renderSection(key, d); if (tab === 'news' && key.startsWith('feed:')) chipsEl.innerHTML = srcChipsHTML(); };
  if (cachedD) paint(cachedD); else main.innerHTML = skeleton();
  try { const d = await loadData(key, force); paint(d); setSub(); }
  catch (e) { if (tok !== renderToken) return; if (!cachedD) main.innerHTML = errorHTML(); else toast('קען נישט דערפרישן יעצט'); }
}
function setSub() {
  const any = state.data[feedKey()];
  let date = '';
  try { const its = any && (any.sections ? any.sections[0].items : any.items) || []; date = (its.find(x => x.src === 'y24' || (!x.src && x.date)) || {}).date || ''; } catch (_) {}
  $('#subline').textContent = (date ? date.replace(/^\S+\s/, '') + ' · ' : '') + srcOn().length + ' מקורות';
}

