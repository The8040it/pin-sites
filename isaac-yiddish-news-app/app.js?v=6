function esc(s) { return String(s == null ? '' : s).replace(/[&<>"']/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c])); }
function fmtTime(t) {
  if (!t) return '';
  const m = String(t).match(/^(\d{1,2}):(\d{2})(?::\d{2})?\s*(am|pm)?$/i);
  if (!m) return t;
  let h = +m[1]; const ap = (m[3] || '').toLowerCase();
  if (ap === 'pm' && h < 12) h += 12; if (ap === 'am' && h === 12) h = 0;
  return h + ':' + m[2];
}
function when(it) {
  if (it.noTime) return 'היינטיגע אויסגאבע';
  if (it.ts) { const d = new Date(it.ts), now = new Date(); const t = d.getHours() + ':' + String(d.getMinutes()).padStart(2, '0');
