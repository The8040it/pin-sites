async function loadMore(btn) {
  const key = btn.dataset.more; const d = state.data[key]; if (!d || !d.items.length) return;
  btn.textContent = 'לאדט…'; btn.disabled = true;
  try {
    const last = d.items[d.items.length - 1];
    const r = await api(`/api/more?s=${encodeURIComponent(key)}&last=${encodeURIComponent(last.id)}&offset=${d.items.length}`);
    const have = new Set(d.items.map(x => x.id));
    const add = r.items.filter(x => !have.has(x.id));
    if (!add.length) { btn.textContent = 'דאס איז אלעס'; return; }
    d.items = d.items.concat(add);
    const html = key === 'news/311' ? blitzHTML(add) : add.map(it => cardHTML(it)).join('');
    btn.insertAdjacentHTML('beforebegin', html);
    btn.textContent = 'ווייז מער ⌄'; btn.disabled = false;
  } catch (_) { btn.textContent = 'פרובירן נאכאמאל ⌄'; btn.disabled = false; }
}
// infinite scroll for paginated sections
