      <a href="${esc(it.url)}" target="_blank" rel="noopener">${/^https:\/\/t\.me\//.test(it.url) ? 'עפן אויף טעלעגראם ↗' : /youtube\.com/.test(it.url) ? 'עפן אויף YouTube ↗' : 'עפן דעם ארגינעל ↗'}</a>
