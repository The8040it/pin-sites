function renderFeed(d, src) {
  const items = (d.items || []).filter(it => src !== 'all' || srcOn().includes(it.src));
  (d.sources || []).forEach(s => { srcStatus[s.key] = s; });
  const badSrc = (d.sources || []).filter(s => !s.ok).map(s => (SRC[s.key] || {}).short || s.name);
  let h = badSrc.length ? `<div class="warn">⚠ ${esc(badSrc.join(', '))} — לאדט נישט יעצט, די אנדערע יא.</div>` : '';
  if (!items.length) return h + `<div class="empty">דערווייל קיין נייעס דא.</div>`;
  if (src !== 'all') h += `<h2 class="pg">${badge({ src })} ${esc(SRC[src].name)}</h2>`;
  const ticker = items.filter(x => x.kind === 'ticker');
  let arts = items.filter(x => x.kind !== 'ticker');
  if (!arts.length) { arts = ticker; }
  const hero = arts.find(x => x.image) || null;
  if (hero) h += heroHTML(hero);
  if (ticker.length && arts !== ticker) h += `<div class="sec-h"><h3>⚡ בליצן און טיקער</h3></div>` + blitzHTML(ticker.slice(0, src === 'all' ? 12 : 40), src === 'all');
