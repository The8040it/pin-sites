    <div class="body">${paras.map(p => `<p dir="rtl">${esc(p)}</p>`).join('')}${loading && !paras.length ? '<div class="sk" style="height:120px"></div>' : ''}${!loading && !paras.length ? `<p class="note">${it.gallery ? '📷 דאס איז א בילדער־גאלעריע (' + it.gallery + ' בילדער). עפן דעם ארגינעל אונטן צו זען אלע בילדער.' : (it.audio || it.video) ? '' : 'דער גאנצער טעקסט איז אויפן ארגינעל — דריק אונטן.'}</p>` : ''}</div>
