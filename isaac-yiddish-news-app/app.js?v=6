function renderHome(d) {
  const sec = k => (d.sections.find(s => s.key === k) || { items: [] }).items;
  const bul = sec('news/57'), blitz = sec('news/311'), alg = sec('news/59'), vid = sec('video'), shm = sec('shmisen'), tor = sec('torah'), mus = sec('music');
  const heroIt = bul.find(x => x.image) || bul[0];
  let h = '';
